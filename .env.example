# octane-mcp configuration. Copy to .env (or pass --env-file <path>) or set these
# as environment variables in your MCP client config.

# --- Connection -------------------------------------------------------------
OCTANE_BASE_URL=https://octane.example.com:8443
OCTANE_SHARED_SPACE_ID=1001
OCTANE_WORKSPACE_ID=1002

# --- Authentication: API access key (preferred) ... -------------------------
OCTANE_CLIENT_ID=
OCTANE_CLIENT_SECRET=
# ... or username / password
# OCTANE_USERNAME=
# OCTANE_PASSWORD=

# --- TLS / network (internal networks) ---------------------------------------
# Default is strict certificate verification.
# Preferred for self-signed or internal CAs: point at the CA bundle (PEM).
# OCTANE_CA_CERT=/path/to/corporate-ca.pem
# Last resort: disable verification for this server only (not process-wide).
# OCTANE_VERIFY_SSL=false
# Proxies are honoured from HTTPS_PROXY / HTTP_PROXY / NO_PROXY.

# --- Behaviour ---------------------------------------------------------------
# Hide every tool that writes to Octane.
# OCTANE_READ_ONLY=false
# Send ALM-OCTANE-TECH-PREVIEW: true (needed for history/audit tools). Default true.
# OCTANE_TECH_PREVIEW=true
# Who "me" / @me resolves to when the server cannot detect it (email or full name).
# OCTANE_CURRENT_USER=jane.doe@example.com
# Map friendly names to instance-specific user-defined fields, as JSON.
# OCTANE_UDF_ALIASES={"acceptance_criteria":"acceptance_criteria_udf"}
# Request timeout in milliseconds.
# OCTANE_TIMEOUT_MS=30000
